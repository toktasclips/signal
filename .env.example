# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Database ─────────────────────────────────────────────────────────────────
# Direct connection string for Prisma migrations
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Pooled connection string for Prisma queries (via PgBouncer)
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Upstash Redis (Rate Limiting) ────────────────────────────────────────────
# https://console.upstash.com → Create Database → REST API sekmesinden al
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Server-only key. Never expose this in NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SYNC_USER_EMAIL=owner@example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
